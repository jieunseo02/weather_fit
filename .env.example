# API 키 (.env)
#
#   cp .env.example .env
#
# .env 는 .gitignore 대상이다. 절대 커밋하지 않는다.
# 실수로 올라갔다면 파일만 지우지 말고 키를 폐기·재발급할 것.
#
# configs/secrets.yaml 을 써도 된다. 둘 중 편한 쪽 하나만 있으면 되고,
# 둘 다 있으면 .env 가 이긴다. 발급처와 용도는 docs/datasets.md §4 참고.

# 기상청 API 허브 — 지상관측·중기예보·특보 전부 이 키 하나
# https://apihub.kma.go.kr  (휴대폰 등록 필수 / API 마다 활용신청 별도)
KMA_APIHUB_AUTH_KEY=

# 네이버 개발자센터 — 데이터랩(쇼핑인사이트)·데이터랩(검색어트렌드) 각각 추가할 것
# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공공데이터포털 — 공휴일·미세먼지 (Decoding 키를 넣을 것)
DATA_GO_KR_SERVICE_KEY=

# KOSIS — 온라인쇼핑동향 (선택)
KOSIS_API_KEY=
